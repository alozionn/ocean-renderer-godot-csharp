[gd_resource type="Theme" load_steps=3 format=3]

[sub_resource type="StyleBoxFlat" id="Panel_style"]
content_margin_left = 10.0
content_margin_top = 8.0
content_margin_right = 10.0
content_margin_bottom = 8.0
bg_color = Color(0.06, 0.07, 0.08, 0.86)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[sub_resource type="StyleBoxFlat" id="Header_style"]
content_margin_left = 6.0
content_margin_top = 4.0
content_margin_right = 6.0
content_margin_bottom = 4.0
bg_color = Color(0.14, 0.16, 0.19, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[resource]
default_font_size = 13
PanelContainer/styles/panel = SubResource("Panel_style")
FoldableContainer/styles/title_panel = SubResource("Header_style")
FoldableContainer/styles/title_collapsed_panel = SubResource("Header_style")
